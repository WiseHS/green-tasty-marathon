# Server only. Copy values from your Neon branch into an ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
FRONTEND_ORIGIN=http://localhost:4200
PUBLIC_BACKEND_URL=http://127.0.0.1:5080
# Required only for the explicit demo seed command; choose a private strong password.
DEMO_WAITER_PASSWORD=
